{
  "name": "prompt-to-video",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "soundtrack": "bun scripts/soundtrack.ts",
    "stills": "bun scripts/render.ts stills",
    "render": "bun scripts/render.ts video",
    "render:prompt": "bun scripts/render.ts video --project prompt-to-video --out out/prompt-to-video.mp4",
    "render:heroes": "bun scripts/render.ts video --project heroes-tonight --out out/heroes-tonight.mp4",
    "render:heroes-blur": "bun scripts/render.ts video --project heroes-tonight --samples 4 --out out/heroes-tonight-blur.mp4",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.2.6",
    "@fontsource/instrument-serif": "5.2.6",
    "@fontsource/inter": "5.2.6",
    "@fontsource/jetbrains-mono": "5.2.6",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/bun": "1.2.21",
    "@types/three": "0.180.0",
    "playwright-core": "1.55.0",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  }
}
